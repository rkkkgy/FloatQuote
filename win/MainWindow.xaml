<Window x:Class="FloatQuote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatQuote"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="167" Height="19"
        FontSize="11"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ToolTip="点击股票展开 · 移开 3 秒收起 · 拖边角调整大小 · 滚轮切换 · 双击锁定 · 右键菜单">
    <Grid>
        <Border x:Name="Chrome" CornerRadius="10" BorderThickness="1" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="#F51E222D"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#FF485062"/>
            </Border.BorderBrush>
        </Border>
        <DockPanel x:Name="Root" Margin="4,1,4,1"/>
    </Grid>
</Window>
